## Ignore Visual Studio temporary files, build results, and files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Rr]elease/
x64/
[Bb]in/
[Oo]bj/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Visual Studio files
.vs/
*.user
*.suo
*.userprefs
*.rsuser
*.userosscache
*.sln.docstates

# Build results
*.log

# dotenv files
.env

# User secrets
appsettings.Development.json
secrets.json
